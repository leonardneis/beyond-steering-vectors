universe = docker
docker_image = $(BsvDockerImage)
executable = /bin/bash
arguments = condor/run_final_state_directional_decomposition_task.sh $(BsvPairIndex) $(BsvStage) $(BsvCommandIndex) $(BsvManifestPath) $(BsvTaskId)
initialdir = $(BsvRepoRoot)
request_CPUs = $(BsvRequestCpus)
request_memory = $(BsvRequestMemoryMB)MB
request_GPUs = 0
requirements = UidDomain == "cs.uni-saarland.de"
getenv = HOME
environment = "SLGEO_SHARED_ROOT=$(BsvSharedRoot) SLGEO_OFFLINE=1 SLGEO_EXECUTION_GIT_COMMIT=$(BsvExecutionGitCommit) SLGEO_EXECUTION_GIT_DIRTY=0 CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId) CONDOR_TASK_ID=$(BsvTaskId)"
+WantGPUHomeMounted = true
+WantScratchMounted = true
+TaskId = "$(BsvTaskId)"
should_transfer_files = NO
max_job_retirement_time = $(BsvRetirementSeconds)
kill_sig = SIGTERM
kill_sig_timeout = 180
stream_output = true
stream_error = true
output = condor/logs/$(BsvTaskId).$(ClusterId).$(ProcId).out
error = condor/logs/$(BsvTaskId).$(ClusterId).$(ProcId).err
log = condor/logs/final_state_directional_decomposition.$(ClusterId).$(ProcId).log
queue 1
