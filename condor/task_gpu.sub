universe = docker
docker_image = $(SlgeoDockerImage)
executable = condor/run_confirmatory_task.sh
arguments = $(SlgeoPairIndex) $(SlgeoStage) $(SlgeoCommandIndex) $(SlgeoManifestPath) $(SlgeoTaskId)
initialdir = $(SlgeoRepoRoot)

request_CPUs = $(SlgeoRequestCpus)
request_memory = $(SlgeoRequestMemoryMB)MB
request_GPUs = 1
gpus_minimum_memory = $(SlgeoMinGpuMemoryMB)
gpus_minimum_capability = 7.0
requirements = UidDomain == "cs.uni-saarland.de"

getenv = HOME
environment = "SLGEO_SHARED_ROOT=$(SlgeoSharedRoot) SLGEO_OFFLINE=1 SLGEO_FORCE_SINGLE_GPU=1 CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId) CONDOR_TASK_ID=$(SlgeoTaskId)"
+WantGPUHomeMounted = true
+WantScratchMounted = true
+TaskId = "$(SlgeoTaskId)"

should_transfer_files = NO
max_job_retirement_time = $(SlgeoRetirementSeconds)
kill_sig = SIGTERM
kill_sig_timeout = 180

stream_output = true
stream_error = true
output = condor/logs/$(SlgeoTaskId).$(ClusterId).$(ProcId).out
error = condor/logs/$(SlgeoTaskId).$(ClusterId).$(ProcId).err
log = condor/logs/confirmatory.$(ClusterId).$(ProcId).log
queue 1
