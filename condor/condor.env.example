# Copy to condor/condor.env. This file contains no scheduler/account secrets.
# The DAG sets SLGEO_SHARED_ROOT from /scratch/compuling/$ENV(USER); override if the SIC quota group changes.
export HF_HOME="${SLGEO_SHARED_ROOT}/huggingface"
# Change to 1 only after the shared HF cache and either the shared venv or custom image exist.
export SLGEO_OFFLINE=0
# Optional generator override:
export CONDOR_CONTAINER_IMAGE="pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime"
# Optional private ntfy runtime notification. Install the ntfy app, choose a
# long, unguessable personal topic, subscribe to it, and set its complete URL
# only in the Git-ignored condor/condor.env file. If unset, notifications are
# disabled and the workflow performs no network request.
# export NTFY_TOPIC="https://ntfy.sh/<private-random-topic>"
