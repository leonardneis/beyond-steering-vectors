universe = docker
docker_image = $(BsvDockerImage)
executable = /bin/bash
arguments = condor/run_cts_stage0_task.sh $(BsvCommand) $(BsvTarget) $(BsvTaskId)
initialdir = $(BsvRepoRoot)
request_CPUs = $(BsvRequestCpus)
request_memory = $(BsvRequestMemoryMB)MB
request_GPUs = 0
requirements = UidDomain == "cs.uni-saarland.de"
getenv = HOME
environment = "SLGEO_SHARED_ROOT=$(BsvSharedRoot) SLGEO_OFFLINE=1 SLGEO_EXECUTION_GIT_COMMIT=$(BsvExecutionGitCommit) SLGEO_RUN_TAG=$(BsvRunTag) SLGEO_CONTAINER_IMAGE=$(BsvDockerImage) CONDOR_CLUSTER_ID=$(ClusterId) CONDOR_PROC_ID=$(ProcId) CONDOR_TASK_ID=$(BsvTaskId)"
+WantGPUHomeMounted = true
+WantScratchMounted = true
+TaskId = "$(BsvTaskId)"
+BsvRunTag = "$(BsvRunTag)"
+BsvBudgetCategory = "$(BsvBudgetCategory)"
should_transfer_files = NO
max_job_retirement_time = 3600
kill_sig = SIGTERM
kill_sig_timeout = 180
stream_output = true
stream_error = true
output = condor/logs/cts_stage0.$(BsvTaskId).$(ClusterId).$(ProcId).out
error = condor/logs/cts_stage0.$(BsvTaskId).$(ClusterId).$(ProcId).err
log = condor/logs/cts_stage0.$(ClusterId).$(ProcId).log
queue 1
