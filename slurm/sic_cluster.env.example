# Copy to slurm/sic_cluster.env (git-ignored) and adapt after checking SIC docs.
export SL_THESIS_REPO_ROOT="$HOME/sl-thesis"
export SL_THESIS_VENV="$HOME/sl-thesis/.venv"
export HF_HOME="/shared/$USER/huggingface"
# Example only: use the actual SIC module names.
export SLURM_MODULES="cuda"
# Optional sbatch flags consumed by submit_confirmatory.sh.
export SIC_SBATCH_COMMON="--partition=gpu --account=YOUR_ACCOUNT"
